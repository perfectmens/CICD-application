# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/

# Gradle files
.gradle/
buildOutputCleanup/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Gradle
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA files
*.iml
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries

# Keystore files (Security Guardrail: Never commit keys)
*.jks
*.keystore
keystore_base64.txt

# External native build folder
.cxx/

# OS-specific files
.DS_Store
Thumbs.db

# Python & Docker
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.env

# Preserve Gradle Wrapper Jar
!gradle/wrapper/gradle-wrapper.jar
